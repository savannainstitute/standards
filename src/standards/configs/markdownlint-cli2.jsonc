{
  // Provisional: every markdownlint default rule; 100 is the YAML line length in yamllint.yaml.
  // Prettier wraps prose to 100 and never wraps a table or a code block, so those are not measured.
  "config": {
    "default": true,
    "MD013": { "line_length": 100, "tables": false, "code_blocks": false }
  },
  // The organization's CLAUDE.md is one import line with no heading, so it is not linted.
  "ignores": ["**/CLAUDE.md"],
  "gitignore": true
}
