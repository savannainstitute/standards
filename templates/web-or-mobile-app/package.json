{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "description": "One sentence on what the app does",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "node ../standards/src/standards/configs/node_modules/eslint/bin/eslint.js --config ../standards/src/standards/configs/eslint.config.mjs .",
    "format": "node ../standards/src/standards/configs/node_modules/prettier/bin/prettier.cjs --config ../standards/src/standards/configs/prettierrc.yaml --no-editorconfig --ignore-path .gitignore --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,css,html}\""
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
